# === App ===
# Set to "production" on real deployments. Outside of production, the Jira
# Issues page's MR review (POST /api/merge-requests/:mrId/review) simulates
# the Claude Code review instead of actually invoking Claude — see
# apps/backend/src/jira-issues/jira-issues.service.ts.
NODE_ENV=development

# === Telegram ===
# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated list of numeric Telegram user IDs allowed to use this bot.
# Do NOT use usernames here. See README for how to find your numeric user ID.
TELEGRAM_ALLOWED_USERS=

# How often (ms) to edit the "in progress" Telegram message while Claude is streaming.
TELEGRAM_EDIT_INTERVAL_MS=1000

# === Claude Code CLI ===
# Command used to invoke Claude Code. Must already be installed and authenticated
# (`claude auth status`) for the OS user that runs this gateway.
CLAUDE_COMMAND=claude

# Maximum time (ms) a single Claude invocation may run before being killed.
CLAUDE_TIMEOUT_MS=1800000

# Permission mode passed to `claude --permission-mode <mode>`.
# Since this gateway runs Claude headlessly (no TTY to answer permission prompts),
# tool calls that require approval (Write/Edit/etc.) will otherwise be silently
# denied. Options: default | acceptEdits | bypassPermissions | plan
# bypassPermissions gives Claude full, unattended tool access in the selected
# workspace (still constrained by the workspace's own .mcp.json / CLAUDE.md).
# Only enable this if you trust everyone in TELEGRAM_ALLOWED_USERS.
CLAUDE_PERMISSION_MODE=bypassPermissions

# Optional: model override passed to `claude --model`. Leave blank to use the
# CLI's own default.
CLAUDE_MODEL=

# === Workspaces ===
# Define one WORKSPACE_<NAME> variable per project the bot may operate on.
# <NAME> becomes the project name used with /project <name> (case-insensitive).
# Each path must be an existing directory. It may contain its own .mcp.json /
# CLAUDE.md which Claude will pick up automatically because the gateway runs
# Claude with this directory as its cwd.
WORKSPACE_CSB_FO=/app/workspace/csb/winvest-core-fo/
WORKSPACE_CSB_BO=/app/workspace/csb/winvest-core-bo/

# === Storage ===
# Path to the SQLite database file used for session persistence.
DATABASE_PATH=./data/gateway.db

# === Uploaded files ===
# Max size (bytes) accepted for a Telegram-uploaded file. Default 20 MB.
MAX_UPLOAD_BYTES=20971520

# === MR Management web application (see README section 16) ===
# HTTP port (NestJS/Express adapter): REST API + static assets + WebSocket upgrade.
HTTP_PORT=3000

# Only GitLab merge request URLs on this host are accepted. Comma-separate
# for more than one allowed host.
GITLAB_ALLOWED_HOST=gitlab.tx-tech.com

# GitLab personal/project access token (needs at least `read_api` scope).
# There is no GitLab MCP server configured. This process itself calls the
# GitLab REST API directly (apps/backend/src/mr/gitlab-client.ts) — both when
# a new MR is submitted (title/author + Jira id extraction, see below), for a
# full review (title/author only), and for "Auto update details" (also a
# direct REST call, never via Claude) — authenticating as a "PRIVATE-TOKEN"
# header. Claude never sees this token for any of those.
GITLAB_TOKEN=

# Jira Cloud API credentials (Basic Auth: email + API token, from
# https://id.atlassian.com/manage-profile/security/api-tokens). Needs read
# access to the issues you'll link MRs to. Used directly by this process
# (apps/backend/src/mr/jira-client.ts) to fetch an issue's Sprint and
# "Responsible" custom field when a new MR is submitted, and by "Auto update
# details" — never via Claude/an MCP server. Leave both blank to skip Jira
# lookups entirely.
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_REVIEWED_PASS_BY_AI_LABEL=CodeReviewedPassByAI
# Optional: override the Claude Skill used for full MR code reviews on a
# per-workspace basis, keyed the same way as WORKSPACE_<NAME> above, e.g.
# REVIEW_SKILL_CSB=reviewcsbfo. Falls back to MR_DEFAULT_REVIEW_SKILL for
# any workspace without its own override.
# REVIEW_SKILL_CSB=reviewcsbfo
MR_DEFAULT_REVIEW_SKILL=reviewcsbfo

# Used to validate/build Jira issue URLs, to tell Claude where issues live,
# and as the base URL for direct Jira REST API calls (see JIRA_EMAIL above).
JIRA_BASE_URL=https://tx-tech.atlassian.net

# Fallback cwd for a Claude MR review when no configured WORKSPACE_<NAME> is
# a git checkout of the submitted MR's GitLab project (matched via each
# workspace's own `git remote get-url origin`). Leave blank if every project
# you'll review already has a WORKSPACE_<NAME>.
MR_REVIEW_WORKSPACE=

# Set to false to disable the WebSocket server (REST API still works).
WEBSOCKET_ENABLED=true

# How many MR reviews may run concurrently; extras queue as PENDING.
MR_REVIEW_CONCURRENCY=2

# Set to false so submitting a new MR only fetches GitLab/Jira intake
# metadata and leaves it PENDING, without starting a Claude review — someone
# must then click "Review" manually. Defaults to true (the historical
# behavior: every new MR is reviewed immediately).
MR_AUTO_REVIEW=true

# === Jira Issues web page (see docs/BACKEND_SPEC.md) ===
# Jira project key the "Jira Issues from Atlassian" table's live view
# searches (JQL: project=<JIRA_PROJECT> order by updated desc).
JIRA_PROJECT=CORE

# === GitLab Activities web page ===
# GitLab host the Activities page's Events API calls hit
# (GET /api/v4/users/:id/events). Falls back to the first host in
# GITLAB_ALLOWED_HOST if unset. Reuses GITLAB_TOKEN for auth.
GITLAB_ACTIVITIES_BASE_URL=https://gitlab.tx-tech.com

# Comma-separated "gitlabUserId:Display Name" pairs — one per teammate whose
# activity should be selectable in the GitLab Activities page's user filter.
# e.g. GITLAB_ACTIVITY_USERS=12345:Pham Nhat Tan,67890:Jane Doe
GITLAB_ACTIVITY_USERS=
GITLAB_ASSIGNED_TO_MANAGER_IDS=62
# Comma-separated "key:Label" pairs controlling which normalized activity
# types are shown/filterable on the Activities page. Recognized keys: commit,
# merge_request, issue, comment. Defaults to all four (shown below) if unset.
# GITLAB_ACTIVITY_TYPES=commit:Commit,merge_request:Merge Request,issue:Issue,comment:Comment

# Comma-separated "optId:valueId:name" pairs controlling which normalized activity
OPS_PROJECTS=
# OPS_PROJECTS=1231-123:2222-123:CSB

# Teams Workflow / Incoming Webhook URL
# TEAMS_WEBHOOK_URL=https://...
TEAMS_WEBHOOK_URL=